# ==============================================================================
# Web Log Analysis System - 통합 환경변수 설정
# 파일 위치: ~/project/config/app.env
#
# 주의사항:
#   1. 실제 파일은 이 이름에서 .example을 제거한 후 사용 (app.env)
#   2. 서버에서는 파일 권한을 600으로 설정: chmod 600 app.env
# ==============================================================================

# ==============================================================================
# [1] 공통 DB 설정
# ==============================================================================
# 로그 DB와 작업 큐 DB가 같은 인스턴스이므로 HOST와 PORT는 공유 가능
DB_HOST=192.168.56.120
DB_PORT=3306
DB_NAME=web_logs

# ==============================================================================
# [2] 로그 읽기 계정 (Log Reader / Export)
# 역할: Apache 로그 테이블만 SELECT 가능
# 사용처: export_db_logs_cli.py, prepare_llm_input.py 등
# ==============================================================================
LOG_DB_USER=log_reader
LOG_DB_PASSWORD=log_reader_secure_password_change_me_123!

# ==============================================================================
# [3] 작업 큐 관리 계정 (Analysis App)
# 역할: analysis_jobs, analysis_reports, job_events 테이블 관리
#      + 로그 테이블 SELECT (export 기능 사용)
# 사용처: analysis_agent.py, web/app.py (FastAPI)
# ==============================================================================
APP_DB_USER=analysis_app
APP_DB_PASSWORD=analysis_app_secure_password_change_me_456!

# ==============================================================================
# [4] Web UI 세션 관리
# ==============================================================================
# 서버 시작 시 자동 생성됨 (사용자 수동 입력 불필요)
# /setup 마법사에서 SessionMiddleware 시크릿 키로 저장됨
SESSION_SECRET_KEY=auto_generated_at_first_run_please_do_not_edit
SESSION_MAX_AGE_SECONDS=3600

# Web UI 바인딩 주소
WEB_HOST=127.0.0.1
WEB_PORT=8080

# ==============================================================================
# [5] Artifact 저장 경로
# ==============================================================================
# analysis_agent가 생성한 파일들이 저장되는 루트 경로
# 디렉터리 구조: ~/project/runs/jobs/<job_id>/
#              - export.json
#              - llm_input.json
#              - stage1_results.json
#              - stage2_report.json
#              - stage2_report.md
#              - viewer_payload.json
ARTIFACT_ROOT=~/project/runs

# ==============================================================================
# [6] LLM 설정 (OpenAI)
# ==============================================================================
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your_openai_api_key_here_abcdef...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# ==============================================================================
# [7] LLM 설정 (Anthropic) - 선택사항
# ==============================================================================
# OpenAI와 Anthropic을 모두 지원하려면 두 키를 다 넣을 수 있음a
# LLM_PROVIDER=openai 또는 LLM_PROVIDER=anthropic으로 선택
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here_xyzabc...
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-6

# ==============================================================================
# [8] Analysis Agent 설정
# ==============================================================================
# Job 폴링 간격 (단위: 초)
AGENT_POLL_INTERVAL_SECONDS=10

# Analysis Agent 워커 ID (여러 에이전트 구분용, 현재는 단일)
AGENT_WORKER_ID=worker-1

# Job 최대 시도 횟수
MAX_JOB_ATTEMPTS=1

# Job 타임아웃 (단위: 초)
JOB_TIMEOUT_SECONDS=600

# ==============================================================================
# [9] 보안 및 운영 설정
# ==============================================================================
# 디버그 모드 (개발 중에만 True, 운영은 False)
DEBUG=False

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 로그 파일 경로
LOG_FILE=~/project/logs/app.log

# ==============================================================================
# [10] 알려진 자산 IP (선택사항)
# ==============================================================================
# 분석 시 무시할 내부 IP 목록 (쉼표로 구분)
# 예: 웹서버, DB서버, LLM서버 자신의 IP
KNOWN_ASSET_IPS=OPTIONAL_ASSET_IP_LIST

# ==============================================================================
# [11] 데이터 보존 정책 (향후 사용)
# ==============================================================================
# Job 아티팩트 보존 기간 (일 단위, 현재는 무제한)
ARTIFACT_RETENTION_DAYS=0