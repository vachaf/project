# ==============================================================================
# Web Log Analysis System - 통합 환경변수 설정 예시
# 파일 위치: ~/project/config/.env.example
# 실제 사용 파일: ~/project/config/.env
#
# 최초 설정:
#   cd ~
#   git clone https://github.com/vachaf/project
#   cd ~/project
#   cp config/.env.example config/.env
#   chmod 600 config/.env
#
# 적용:
#   set -a
#   source ./config/.env
#   set +a
#
# 원칙:
#   - config/.env 하나만 사용한다.
#   - LLM_PROVIDER는 기본 env 값으로 고정하지 않는다.
#   - provider 선택은 job/runner 또는 실행 계층에서 명시한다.
# ==============================================================================

# ==============================================================================
# [1] 공통 DB endpoint
# ==============================================================================
# 공통 endpoint를 사용하면 reader/app/shipper는 이 값을 fallback으로 사용한다.
DB_HOST=192.168.56.120
DB_PORT=3306
DB_NAME=web_logs

# role별 endpoint가 별도일 때만 override한다. credential과 달리 endpoint는
# legacy LOG_DB_* fallback을 지원한다.
# LOG_DB_HOST=
# LOG_DB_PORT=
# LOG_DB_NAME=
# APP_DB_HOST=
# APP_DB_PORT=
# APP_DB_NAME=
# SHIPPER_DB_HOST=
# SHIPPER_DB_PORT=
# SHIPPER_DB_NAME=

# ==============================================================================
# [2] 로그 읽기 계정 (Log Reader / Export)
# ==============================================================================
# 역할: Apache 로그 테이블 SELECT (Live / Export)
LOG_DB_USER=log_reader
LOG_DB_PASSWORD=log_reader_secure_password_change_me

# ==============================================================================
# [3] 작업 큐 관리 계정 (Analysis App)
# ==============================================================================
# 역할: analysis_jobs, analysis_reports, job_events 관리
#      + 로그 테이블 SELECT
# 사용처: analysis_agent.py, web/app.py
APP_DB_USER=analysis_app
APP_DB_PASSWORD=analysis_app_secure_password_change_me

# ==============================================================================
# [4] Apache log shipper writer 계정
# ==============================================================================
# 역할: Apache source log table INSERT/UPDATE. LOG_DB_* reader credential을
# 재사용하지 않는다.
SHIPPER_DB_USER=log_writer
SHIPPER_DB_PASSWORD=log_writer_secure_password_change_me

# ==============================================================================
# [5] Web UI 세션 및 바인딩
# ==============================================================================
# 서버 시작 시 자동 생성 또는 운영자가 별도 지정
SESSION_SECRET_KEY=auto_generated_at_first_run_please_do_not_edit
SESSION_MAX_AGE_SECONDS=3600

WEB_HOST=127.0.0.1
WEB_PORT=8000

# ==============================================================================
# [6] Artifact 저장 경로
# ==============================================================================
# analysis_agent가 생성한 파일들이 저장되는 루트 경로
# 디렉터리 구조: ~/project/runs/jobs/<job_id>/
#              - manifest.json
#              - export.json
#              - llm_input.json
#              - stage1_results.json
#              - stage2_report_input.json
#              - stage2_report.json
#              - stage2_report.md
#              - viewer_payload.json
#              - noise_summary.json
ARTIFACT_ROOT=/opt/web_log_analysis/runs

# ==============================================================================
# [7] LLM 설정 (OpenAI)
# ==============================================================================
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=YOUR_OPENAI_MODEL

# ==============================================================================
# [8] LLM 설정 (Anthropic, 선택사항)
# ==============================================================================
# OpenAI와 Anthropic을 모두 지원하려면 두 키를 같은 env 파일에 함께 둘 수 있다.
# provider 선택은 이 파일의 LLM_PROVIDER가 아니라 job/runner 또는 실행 인자에서 한다.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=YOUR_ANTHROPIC_MODEL
ANTHROPIC_MAX_TOKENS=8192

# ==============================================================================
# [9] Analysis Agent 설정
# ==============================================================================
AGENT_POLL_INTERVAL_SECONDS=10
AGENT_WORKER_ID=worker-1
MAX_JOB_ATTEMPTS=1
JOB_TIMEOUT_SECONDS=600
WORKER_DEPENDENCY_HEALTH_TTL_SECONDS=30

# ==============================================================================
# [10] 보안 및 운영 설정
# ==============================================================================
DEBUG=False
LOG_LEVEL=INFO
LOG_FILE=~/project/logs/app.log

# ==============================================================================
# [11] 알려진 자산 IP (선택사항)
# ==============================================================================
# 분석 시 내부 자산 IP를 참고해야 할 때만 쉼표로 구분해 지정한다.
KNOWN_ASSET_IPS=OPTIONAL_ASSET_IP_LIST

# ==============================================================================
# [12] 데이터 보존 정책 (향후 사용)
# ==============================================================================
# Job 아티팩트 보존 기간 (일 단위, 0은 무제한)
ARTIFACT_RETENTION_DAYS=0
