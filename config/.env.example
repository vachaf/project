# ==============================================================================
# Web Log Analysis System - 통합 환경변수 설정 예시
# 파일 위치: ~/project/config/.env.example
# 실제 사용 파일: ~/project/config/.env
#
# 최초 설정:
#   cd ~
#   git clone https://github.com/vachaf/project
#   cd ~/project
#   cp config/.env.example config/.env
#   chmod 600 config/.env
#
# 적용:
#   set -a
#   source ./config/.env
#   set +a
#
# 원칙:
#   - config/.env 하나만 사용한다.
#   - LLM_PROVIDER는 기본 env 값으로 고정하지 않는다.
#   - provider 선택은 job/runner 또는 실행 계층에서 명시한다.
# ==============================================================================

# ==============================================================================
# [1] 공통 DB 설정
# ==============================================================================
# 로그 DB와 작업 큐 DB가 같은 인스턴스이므로 HOST와 PORT는 공유 가능
DB_HOST=192.168.56.120
DB_PORT=3306
DB_NAME=web_logs

# ==============================================================================
# [2] 로그 읽기 계정 (Log Reader / Export)
# ==============================================================================
# 역할: Apache 로그 테이블 SELECT
LOG_DB_USER=log_reader
LOG_DB_PASSWORD=log_reader_secure_password_change_me

# ==============================================================================
# [3] 작업 큐 관리 계정 (Analysis App)
# ==============================================================================
# 역할: analysis_jobs, analysis_reports, job_events 관리
#      + 로그 테이블 SELECT
# 사용처: analysis_agent.py, web/app.py
APP_DB_USER=analysis_app
APP_DB_PASSWORD=analysis_app_secure_password_change_me

# ==============================================================================
# [4] Web UI 세션 및 바인딩
# ==============================================================================
# 서버 시작 시 자동 생성 또는 운영자가 별도 지정
SESSION_SECRET_KEY=auto_generated_at_first_run_please_do_not_edit
SESSION_MAX_AGE_SECONDS=3600

WEB_HOST=127.0.0.1
WEB_PORT=8000

# ==============================================================================
# [5] Artifact 저장 경로
# ==============================================================================
# analysis_agent가 생성한 파일들이 저장되는 루트 경로
# 디렉터리 구조: ~/project/runs/jobs/<job_id>/
#              - manifest.json
#              - export.json
#              - llm_input.json
#              - stage1_results.json
#              - stage2_report_input.json
#              - stage2_report.json
#              - stage2_report.md
#              - viewer_payload.json
#              - noise_summary.json
ARTIFACT_ROOT=~/project/runs

# ==============================================================================
# [6] LLM 설정 (OpenAI)
# ==============================================================================
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=YOUR_OPENAI_MODEL

# ==============================================================================
# [7] LLM 설정 (Anthropic, 선택사항)
# ==============================================================================
# OpenAI와 Anthropic을 모두 지원하려면 두 키를 같은 env 파일에 함께 둘 수 있다.
# provider 선택은 이 파일의 LLM_PROVIDER가 아니라 job/runner 또는 실행 인자에서 한다.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=YOUR_ANTHROPIC_MODEL
ANTHROPIC_MAX_TOKENS=8192

# ==============================================================================
# [8] Analysis Agent 설정
# ==============================================================================
AGENT_POLL_INTERVAL_SECONDS=10
AGENT_WORKER_ID=worker-1
MAX_JOB_ATTEMPTS=1
JOB_TIMEOUT_SECONDS=600

# ==============================================================================
# [9] 보안 및 운영 설정
# ==============================================================================
DEBUG=False
LOG_LEVEL=INFO
LOG_FILE=~/project/logs/app.log

# ==============================================================================
# [10] 알려진 자산 IP (선택사항)
# ==============================================================================
# 분석 시 내부 자산 IP를 참고해야 할 때만 쉼표로 구분해 지정한다.
KNOWN_ASSET_IPS=OPTIONAL_ASSET_IP_LIST

# ==============================================================================
# [11] 데이터 보존 정책 (향후 사용)
# ==============================================================================
# Job 아티팩트 보존 기간 (일 단위, 0은 무제한)
ARTIFACT_RETENTION_DAYS=0
