{
  "description": "Stage dry-run should preserve auth behavior summaries as context-only auth sequence context without claiming confirmed auth success.",
  "MUST": [
    {
      "op": "json_path_exists",
      "file": "stage2_report_input",
      "path": "pipeline_counts.auth_behavior_summary_count",
      "message": "auth behavior summary count exists"
    },
    {
      "op": "json_path_equals",
      "file": "stage2_report_input",
      "path": "pipeline_counts.auth_behavior_summary_count",
      "equals": 1,
      "message": "auth behavior summary count is preserved"
    },
    {
      "op": "json_path_exists",
      "file": "stage2_report_input",
      "path": "policy_notes.auth_behavior_summary_policy",
      "message": "auth behavior summary policy exists"
    },
    {
      "op": "json_path_exists",
      "file": "stage2_report_input",
      "path": "policy_notes.behavior_scope_separation_policy",
      "message": "behavior scope separation policy exists"
    },
    {
      "op": "json_path_contains",
      "file": "stage2_report_input",
      "path": "policy_notes.behavior_scope_separation_policy.non_merge_rule",
      "contains": "range 표현",
      "message": "behavior scope separation policy forbids merged range wording"
    },
    {
      "op": "json_path_exists",
      "file": "stage2_report_input",
      "path": "policy_notes.user_agent_interpretation_policy",
      "message": "user agent interpretation policy exists"
    },
    {
      "op": "json_path_contains",
      "file": "stage2_report_input",
      "path": "policy_notes.user_agent_interpretation_policy.generalization_rule",
      "contains": "lab-* 같은 실험 prefix",
      "message": "user agent policy avoids lab prefix as detection rationale"
    },
    {
      "op": "json_path_exists",
      "file": "stage2_report_input",
      "path": "policy_notes.supporting_events_policy.auth_behavior_rule",
      "message": "supporting events policy includes auth behavior support rule"
    },
    {
      "op": "json_path_equals",
      "file": "stage2_report_input",
      "path": "auth_behavior_summaries.0.context_role",
      "equals": "auth_behavior_context",
      "message": "auth behavior summary keeps context role"
    },
    {
      "op": "json_path_equals",
      "file": "stage2_report_input",
      "path": "auth_behavior_summaries.0.should_promote_to_candidate",
      "equals": false,
      "message": "auth behavior summary stays non-promoting"
    },
    {
      "op": "json_path_equals",
      "file": "stage2_report_input",
      "path": "auth_behavior_summaries.0.interpretation_limit",
      "equals": "post_body_not_visible_no_auth_success_inference",
      "message": "auth behavior summary keeps interpretation limit"
    },
    {
      "op": "json_path_equals",
      "file": "stage2_report_input",
      "path": "pipeline_counts.candidate_rows",
      "equals": 3,
      "message": "candidate rows are reduced to representative auth incidents"
    },
    {
      "op": "json_path_equals",
      "file": "stage2_report_input",
      "path": "pipeline_counts.supporting_event_count",
      "equals": 1,
      "message": "supporting event count captures demoted auth row"
    },
    {
      "op": "json_path_contains",
      "file": "stage2_report_input",
      "path": "policy_notes.auth_behavior_summary_policy.mixed_status_rule",
      "contains": "HTTP 200 observed after repeated 401",
      "message": "auth summary policy keeps mixed-status caution"
    },
    {
      "op": "json_path_contains",
      "file": "stage2_prompt_bundle",
      "path": "system_prompt",
      "contains": "HTTP 200 observed after repeated 401",
      "message": "stage2 prompt keeps mixed 401/200 caution"
    },
    {
      "op": "json_path_contains",
      "file": "stage2_prompt_bundle",
      "path": "system_prompt",
      "contains": "count scope 를 분리하라",
      "message": "stage2 prompt separates auth and ip behavior count scope"
    },
    {
      "op": "json_path_contains",
      "file": "stage2_prompt_bundle",
      "path": "system_prompt",
      "contains": "lab-* 같은 실험 prefix 자체를 탐지 근거로 삼지 마라",
      "message": "stage2 prompt avoids lab prefix as attack rationale"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "context-only auth behavior summaries:",
      "message": "markdown includes auth behavior context section"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "raw POST body 미확인",
      "message": "markdown includes post body visibility limitation"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "scope 구분:",
      "message": "markdown includes explicit auth/ip scope separation note"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "window_requests=",
      "message": "markdown labels ip behavior request count with window scope"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "auth_requests=",
      "message": "markdown labels auth behavior request count with auth scope"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "lab-* 같은 실험 prefix 자체를 공격 근거로 사용하지 않고",
      "message": "markdown generalizes user-agent interpretation instead of relying on lab prefix"
    },
    {
      "op": "list_any_equals",
      "file": "stage2_report_input",
      "path": "top_incidents",
      "where": {
        "request_id": "f-r1-auth-fail-1"
      },
      "field": "request_id",
      "equals": "f-r1-auth-fail-1",
      "message": "401 auth request remains in stage2 report input"
    },
    {
      "op": "list_any_equals",
      "file": "stage2_report_input",
      "path": "supporting_events",
      "where": {
        "supporting_role": "auth_behavior_support"
      },
      "field": "supporting_reason",
      "equals": "covered_by_auth_behavior_summary",
      "message": "stage2 report input keeps auth behavior support event"
    }
  ],
  "MUST_NOT": [
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "48~51",
      "message": "markdown must not merge auth and ip behavior counts into a range"
    },
    {
      "op": "file_contains_unless_context",
      "file": "stage2_report_md",
      "contains": "로그인 성공 confirmed",
      "allowed_context_contains": [
        "단정하지 않는다",
        "단정하지 마라"
      ],
      "message": "markdown must not claim confirmed login success"
    },
    {
      "op": "file_contains_unless_context",
      "file": "stage2_report_md",
      "contains": "credential stuffing 성공",
      "allowed_context_contains": [
        "단정하지 않는다",
        "단정하지 마라"
      ],
      "message": "markdown must not claim credential stuffing success"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "lab-f-set이므로 공격",
      "message": "markdown must not use lab-f-set prefix itself as attack rationale"
    }
  ]
}
