{
  "description": "Stage dry-run should preserve sensitive path probe summaries as context-only scanner-like probing context without asserting app presence, exposure, blocked success, or attack success.",
  "MUST": [
    {
      "op": "json_path_exists",
      "file": "stage2_report_input",
      "path": "pipeline_counts.sensitive_path_probe_summary_count",
      "message": "sensitive path probe summary count exists"
    },
    {
      "op": "json_path_equals",
      "file": "stage2_report_input",
      "path": "pipeline_counts.sensitive_path_probe_summary_count",
      "equals": 1,
      "message": "sensitive path probe summary count is preserved"
    },
    {
      "op": "json_path_exists",
      "file": "stage2_report_input",
      "path": "policy_notes.sensitive_path_probe_summary_policy",
      "message": "sensitive path probe summary policy exists"
    },
    {
      "op": "json_path_contains",
      "file": "stage2_report_input",
      "path": "policy_notes.sensitive_path_probe_summary_policy.success_rule",
      "contains": "WordPress 존재, admin access, .env 노출, phpinfo 노출, server-status 노출/차단, backup 노출, 공격 성공을 단정하지 않음",
      "message": "sensitive path probe policy keeps conservative success rule"
    },
    {
      "op": "json_path_contains",
      "file": "stage2_report_input",
      "path": "policy_notes.behavior_scope_separation_policy.non_merge_rule",
      "contains": "sensitive_path_probe_summaries",
      "message": "behavior scope separation policy includes sensitive path probe summaries"
    },
    {
      "op": "json_path_equals",
      "file": "stage2_report_input",
      "path": "sensitive_path_probe_summaries.0.context_role",
      "equals": "sensitive_path_probe_context",
      "message": "sensitive path probe summary keeps context role"
    },
    {
      "op": "json_path_equals",
      "file": "stage2_report_input",
      "path": "sensitive_path_probe_summaries.0.should_promote_to_candidate",
      "equals": false,
      "message": "sensitive path probe summary stays non-promoting"
    },
    {
      "op": "json_path_equals",
      "file": "stage2_report_input",
      "path": "sensitive_path_probe_summaries.0.interpretation_limit",
      "equals": "sensitive_path_probe_no_file_or_app_exposure_inference",
      "message": "sensitive path probe summary keeps interpretation limit"
    },
    {
      "op": "list_any_contains",
      "file": "llm_input",
      "path": "supporting_events",
      "where": {
        "supporting_role": "sensitive_path_probe_support",
        "request_id": "h-r3-server-status-1"
      },
      "field": "reason_hints",
      "contains": "sensitive_path:server_status",
      "message": "dry-run llm_input keeps row-specific server-status support hint"
    },
    {
      "op": "list_any_contains",
      "file": "llm_input",
      "path": "supporting_events",
      "where": {
        "supporting_role": "sensitive_path_probe_support",
        "request_id": "h-r3-server-status-1"
      },
      "field": "reason_hints",
      "contains": "sensitive_path:covered_by_sensitive_path_probe_summary",
      "message": "dry-run llm_input keeps covered-by-summary support hint"
    },
    {
      "op": "json_path_contains",
      "file": "stage2_prompt_bundle",
      "path": "system_prompt",
      "contains": "sensitive_path_probe_summaries 가 있으면 이는 context-only",
      "message": "stage2 prompt includes sensitive path probe context-only rule"
    },
    {
      "op": "json_path_contains",
      "file": "stage2_prompt_bundle",
      "path": "system_prompt",
      "contains": "WordPress 존재, admin access, .env 노출, phpinfo 노출, server-status 노출/차단, backup 노출, 공격 성공을 단정하지 마라",
      "message": "stage2 prompt includes sensitive path probe no-success-inference rule"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "Sensitive path probe context",
      "message": "markdown includes sensitive path probe context section"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "sensitive path probe 해석 제한",
      "message": "markdown includes sensitive path probe interpretation limitation"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "path_categories=",
      "message": "markdown includes sensitive path category list"
    }
  ],
  "MUST_NOT": [
    {
      "op": "file_contains_unless_context",
      "file": "stage2_report_md",
      "contains": "WordPress 존재",
      "allowed_context_contains": [
        "단정하지 않는다",
        "단정하지 마라"
      ],
      "message": "markdown must not assert WordPress presence"
    },
    {
      "op": "file_contains_unless_context",
      "file": "stage2_report_md",
      "contains": "admin access",
      "allowed_context_contains": [
        "단정하지 않는다",
        "단정하지 마라"
      ],
      "message": "markdown must not assert admin access"
    },
    {
      "op": "file_contains_unless_context",
      "file": "stage2_report_md",
      "contains": ".env 노출",
      "allowed_context_contains": [
        "단정하지 않는다",
        "단정하지 마라"
      ],
      "message": "markdown must not assert .env exposure"
    },
    {
      "op": "file_contains_unless_context",
      "file": "stage2_report_md",
      "contains": "phpinfo 노출",
      "allowed_context_contains": [
        "단정하지 않는다",
        "단정하지 마라"
      ],
      "message": "markdown must not assert phpinfo exposure"
    },
    {
      "op": "file_contains_unless_context",
      "file": "stage2_report_md",
      "contains": "server-status 노출",
      "allowed_context_contains": [
        "단정하지 않는다",
        "단정하지 마라"
      ],
      "message": "markdown must not assert server-status exposure"
    },
    {
      "op": "file_contains_unless_context",
      "file": "stage2_report_md",
      "contains": "backup 노출",
      "allowed_context_contains": [
        "단정하지 않는다",
        "단정하지 마라"
      ],
      "message": "markdown must not assert backup exposure"
    },
    {
      "op": "file_contains_unless_context",
      "file": "stage2_report_md",
      "contains": "attack success",
      "allowed_context_contains": [
        "단정하지 않는다",
        "단정하지 마라"
      ],
      "message": "markdown must not assert attack success"
    },
    {
      "op": "list_any_contains",
      "file": "llm_input",
      "path": "supporting_events",
      "where": {
        "supporting_role": "sensitive_path_probe_support",
        "request_id": "h-r3-server-status-1"
      },
      "field": "reason_hints",
      "contains": "sensitive_path:wp_login",
      "message": "dry-run llm_input support event must not carry unrelated wp_login hint"
    }
  ]
}
