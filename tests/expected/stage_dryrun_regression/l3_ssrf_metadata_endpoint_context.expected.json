    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "internal access success",
      "message": "markdown must not assert internal access success"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "outbound request success",
      "message": "markdown must not assert outbound request success"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "server compromise",
      "message": "markdown must not assert server compromise"
    }
  ]
