{
  "description": "Search baseline dry-run should keep candidate-excluded baseline-like context separate from attack candidates.",
  "MUST": [
    {
      "op": "json_path_exists",
      "file": "stage2_report_input",
      "path": "policy_notes.reference_baseline_policy",
      "message": "reference baseline policy exists"
    },
    {
      "op": "list_any_equals",
      "file": "stage2_report_input",
      "path": "top_filtered_categories",
      "where": {
        "category": "known_baseline_like_legacy_alias"
      },
      "field": "category",
      "equals": "known_baseline_like_legacy_alias",
      "message": "legacy Prepare baseline category is normalized for Stage2 reporting"
    },
    {
      "op": "list_any_equals",
      "file": "stage2_report_input",
      "path": "supporting_events",
      "where": {
        "request_id": "e-r3-search-baseline-1"
      },
      "field": "supporting_role",
      "equals": "reference_baseline",
      "message": "baseline request is preserved as reference_baseline supporting event"
    },
    {
      "op": "list_any_equals",
      "file": "stage2_report_input",
      "path": "top_incidents",
      "where": {
        "request_id": "e-r3-search-sqli-1"
      },
      "field": "request_id",
      "equals": "e-r3-search-sqli-1",
      "message": "SQLi candidate remains in report input"
    },
    {
      "op": "list_any_equals",
      "file": "stage2_report_input",
      "path": "top_incidents",
      "where": {
        "request_id": "e-r3-search-xss-1"
      },
      "field": "request_id",
      "equals": "e-r3-search-xss-1",
      "message": "XSS candidate remains in report input"
    },
    {
      "op": "json_path_contains",
      "file": "stage2_prompt_bundle",
      "path": "system_prompt",
      "contains": "known_baseline_like 또는 known_baseline_like_legacy_alias filtered_out category 는 low_signal_fuzzing 과 분리해서 candidate-excluded baseline-like 또는 reference baseline 으로 표현하라.",
      "message": "stage2 prompt distinguishes baseline from low-signal fuzzing"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "baseline-like 정책",
      "message": "markdown includes baseline policy note"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "known_baseline_like_legacy_alias",
      "message": "markdown exposes the normalized legacy baseline category"
    }
  ],
  "MUST_NOT": [
    {
      "op": "list_any_equals",
      "file": "stage2_report_input",
      "path": "top_out_of_candidate_recon",
      "where": {
        "category": "known_baseline_like_legacy_alias"
      },
      "field": "category",
      "equals": "known_baseline_like_legacy_alias",
      "message": "baseline must not be reclassified as out-of-candidate recon"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "benign_normal_search",
      "message": "markdown must not restore obsolete benign baseline wording"
    },
    {
      "op": "file_contains_unless_context",
      "file": "stage2_report_md",
      "contains": "공격 성공",
      "allowed_context_contains": [
        "단정",
        "근거로 사용하지"
      ],
      "message": "markdown must not assert successful attack"
    }
  ]
}
