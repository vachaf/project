{
  "description": "Stage dry-run should preserve open redirect-like candidates while avoiding redirect/phishing success assertions beyond Apache log evidence.",
  "MUST": [
    {
      "op": "list_any_contains",
      "file": "stage1_request_plan",
      "path": "",
      "where": {
        "request_id": "l3-open-redirect-1"
      },
      "field": "message_preview.user_payload.candidate.reason_hints",
      "contains": "l3:open_redirect_probe",
      "message": "stage1 payload keeps open redirect L3 hint"
    },
    {
      "op": "list_any_contains",
      "file": "stage1_request_plan",
      "path": "",
      "where": {
        "request_id": "l3-open-redirect-2"
      },
      "field": "message_preview.user_payload.candidate.reason_hints",
      "contains": "open_redirect:protocol_relative_url",
      "message": "stage1 payload keeps protocol-relative redirect hint"
    },
    {
      "op": "list_any_equals",
      "file": "stage2_report_input",
      "path": "top_incidents",
      "where": {
        "request_id": "l3-open-redirect-1"
      },
      "field": "request_id",
      "equals": "l3-open-redirect-1",
      "message": "stage2 report input keeps next external URL probe"
    },
    {
      "op": "list_any_equals",
      "file": "stage2_report_input",
      "path": "top_incidents",
      "where": {
        "request_id": "l3-open-redirect-2"
      },
      "field": "request_id",
      "equals": "l3-open-redirect-2",
      "message": "stage2 report input keeps protocol-relative probe"
    },
    {
      "op": "list_any_equals",
      "file": "stage2_report_input",
      "path": "top_incidents",
      "where": {
        "request_id": "l3-open-redirect-3"
      },
      "field": "request_id",
      "equals": "l3-open-redirect-3",
      "message": "stage2 report input keeps continue external URL probe"
    },
    {
      "op": "json_path_contains",
      "file": "stage2_report_input",
      "path": "policy_notes.sensitive_path_probe_summary_policy.success_rule",
      "contains": "status_code, response_body_bytes, content_type",
      "message": "policy notes preserve Apache logs-only success boundary"
    }
  ],
  "MUST_NOT": [
    {
      "op": "list_any_equals",
      "file": "stage1_request_plan",
      "path": "",
      "where": {
        "request_id": "l3-open-redirect-benign-1"
      },
      "field": "request_id",
      "equals": "l3-open-redirect-benign-1",
      "message": "stage1 payload must not promote relative next baseline"
    },
    {
      "op": "list_any_equals",
      "file": "stage1_request_plan",
      "path": "",
      "where": {
        "request_id": "l3-open-redirect-benign-3"
      },
      "field": "request_id",
      "equals": "l3-open-redirect-benign-3",
      "message": "stage1 payload must not promote documentation URL baseline"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "open redirect confirmed",
      "message": "markdown must not assert open redirect confirmation"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "redirect succeeded",
      "message": "markdown must not assert redirect success"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "victim followed redirect",
      "message": "markdown must not assert victim redirect follow"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "phishing succeeded",
      "message": "markdown must not assert phishing success"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "credential theft",
      "message": "markdown must not assert credential theft"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "browser redirected",
      "message": "markdown must not assert browser redirect success"
    },
    {
      "op": "file_contains",
      "file": "stage2_report_md",
      "contains": "exploit succeeded",
      "message": "markdown must not assert exploit success"
    }
  ]
}
