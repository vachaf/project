{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "external_security_benchmark_case.v1.schema.json",
  "title": "Joined external security benchmark case v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "source", "request", "observability", "expected", "annotation"],
  "properties": {
    "schema_version": {"const": "external_security_benchmark_case.v1"},
    "case_id": {"type": "string", "pattern": "^owasp_crs\\.[0-9]+\\.[0-9]+$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark", "revision", "rule_id", "test_id", "description", "expectation"],
      "properties": {
        "benchmark": {"const": "owasp_crs"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "rule_id": {"type": "integer"},
        "test_id": {"type": "integer"},
        "description": {"type": "string"},
        "expectation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ids"],
          "properties": {
            "kind": {"enum": ["expect_ids", "no_expect_ids"]},
            "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}}
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "request_target", "http_version", "headers", "body"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "request_target": {"type": "string", "minLength": 1},
        "http_version": {"type": "string", "minLength": 1},
        "headers": {"type": "object", "additionalProperties": {"type": "string"}},
        "body": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["present", "text"],
              "properties": {
                "present": {"const": true},
                "text": {"type": "string"}
              }
            }
          ]
        }
      }
    },
    "observability": {"$ref": "external_security_benchmark_manifest.v1.schema.json#/$defs/observability"},
    "expected": {"$ref": "external_security_benchmark_manifest.v1.schema.json#/$defs/expected"},
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "review"],
      "properties": {
        "version": {"const": "owasp_crs_path_file_access.v1"},
        "review": {"$ref": "external_security_benchmark_manifest.v1.schema.json#/$defs/review"}
      }
    }
  }
}
