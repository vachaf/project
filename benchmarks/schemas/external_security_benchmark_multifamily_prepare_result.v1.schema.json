    "complete": {"type": "boolean"},
    "run": {"type": "object"},
    "counts": {"type": "object"},
    "component_counts": {"type": "object"},
    "metrics": {"type": "object"},
    "diagnostics": {"type": "object"},
    "cases": {"type": "array", "items": {"type": "object"}}
